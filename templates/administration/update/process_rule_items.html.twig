{% extends 'small.html.twig' %}

{% trans_default_domain 'mosparo' %}

{% block documentTitle %}{{ 'administration.update.finalize.process.optimizeRuleItems.title'|trans }} - {{ parent() }}{% endblock %}

{% block small_body %}
    <h2 class="card-title text-center mb-4">{{ 'administration.update.finalize.process.optimizeRuleItems.title'|trans }}</h2>

    <div class="alert alert-danger d-none" id="tasks-error-message">
        {{ 'administration.update.finalize.process.optimizeRuleItems.error'|trans }}
    </div>

    <p>
        {{ 'administration.update.finalize.process.optimizeRuleItems.intro'|trans }}
    </p>

    <div class="progress-bar-container my-4">
        <div class="d-flex justify-content-between mb-2">
            <div id="progress-modal-status">{{ 'administration.update.finalize.process.optimizeRuleItems.processingPleaseWait'|trans }}</div>
            <div class="ms-auto">{{ 'administration.update.finalize.process.optimizeRuleItems.processingStats'|trans({'%processedTasks%': '<strong id="tasks-processed">0</strong>', '%totalTasks%': '<strong>' ~ numberOfTasks ~ '</strong>'})|raw }}</div>
        </div>
        <div class="progress">
            <div class="progress-bar" id="tasks-progress-bar"></div>
        </div>
        <div class="alert alert-success mb-0 text-start d-none">
            {{ 'rules.fieldRule.form.modal.addingTasks.messageCompleted'|trans }}
        </div>
    </div>

    <div class="alert alert-warning">
        {{ 'administration.update.finalize.process.optimizeRuleItems.doNotLeave'|trans }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% cspscript %}
        <script>
            var totalTasks = {{ numberOfTasks }};
            var processedTasks = 0;
            var failedAttempts = 0;

            function processTasks()
            {
                $.post('{{ path('administration_update_finalize_process_optimize_rule_items') }}', { process: true, token: '{{ csrf_token('process-tasks') }}'}, function (responseData) {
                    failedAttempts = 0;

                    if (responseData.finished) {
                        window.location.href = '{{ urlAfterProcess }}';
                        return;
                    }

                    processedTasks += responseData.processedTasks;

                    let percent = (processedTasks / totalTasks) * 100;

                    $('#tasks-processed').text(processedTasks);
                    $('#tasks-progress-bar').css('width', percent + '%');

                    setTimeout(processTasks, 1);
                }).fail(function () {
                    failedAttempts++;
                    if (failedAttempts < 5) {
                        setTimeout(processTasks, 1000);
                        return;
                    }

                    $('#tasks-error-message').removeClass('d-none');
                });
            }

            $(document).ready(function () {
                processTasks();
            });
        </script>
    {% endcspscript %}

{% endblock %}
