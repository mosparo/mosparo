{% extends 'small.html.twig' %}

{% trans_default_domain 'mosparo' %}

{% block documentTitle %}{{ 'security.login.title'|trans }} - {{ parent() }}{% endblock %}

{% block small_body %}
    <form method="post">
        <h2 class="card-title text-center mb-4">{{ 'security.login.title'|trans }}</h2>

        {% if error %}
            {% set domain = 'security' %}
            {% if 'oidc.errorMessages' in error.messageKey %}
                {% set domain = 'mosparo' %}
            {% endif %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, domain) }}</div>
        {% endif %}

        {% block pageFlashes %}
            {% include 'snippets/flashes.html.twig' %}
        {% endblock %}

        <div class="card-loader">
            <div class="loader-content">
                <div class="loader"></div>
                <span class="mt-5">{{ 'security.login.loading'|trans }}</span>
            </div>
        </div>

        <div class="alert alert-danger mt-3 d-none" id="authentication-error-message"></div>

        {% if app.user %}
            <div class="alert alert-info">
                <div>
                    {{ 'security.login.youAreLoggedIn'|trans({'%username%': app.user.username}, 'mosparo') }} <a href="{{ path('security_logout', {'token' : csrf_token('logout')}) }}">{{ 'security.logout.title'|trans }}</a>
                </div>
            </div>
        {% endif %}

        <div class="mb-3">
            <label class="form-label required" for="field-email">{{ 'security.login.emailLabel'|trans }}</label>
            <input type="email" id="field-email" name="_username" class="form-control" autofocus autocomplete="username webauthn">
        </div>
        <div class="mb-2">
            <label class="form-label required" for="field-password">
                {{ 'security.login.passwordLabel'|trans }}
                <span class="form-label-description">
                    <a href="{{ path('security_reset') }}" tabindex="4">{{ 'security.forgotPassword.title'|trans }}</a>
                </span>
            </label>
            <input type="password" id="field-password" name="_password" class="form-control" autocomplete="off">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <input type="hidden" id="assertion" name="_assertion">

        <div class="form-footer">
            <button type="submit" class="btn btn-primary w-100">
                <i class="ti ti-login"></i>
                {{ 'security.login.title'|trans }}
            </button>
        </div>

        {% for client in oidcClients %}
            <a href="{{ path('login_oidc', {'alias': client.alias}) }}" class="btn btn-oidc-client-login w-100 mt-3">
                {% if client.iconUrl %}
                    <img src="{{ client.iconUrl }}" class="oidc-client-icon" alt="">
                {% endif %}
                {{ 'action.authenticateWithOidc'|trans({ '%name%': client.name }) }}
            </a>
        {% endfor %}

        {% if isWebauthnAvailable %}
            <button type="button" id="login-with-passkey" class="btn btn-yellow w-100 mt-3 d-none">
                <i class="ti ti-key"></i>
                {{ 'action.authenticateWithPasskey'|trans }}
            </button>
        {% endif %}
    </form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {% if isWebauthnAvailable %}
        {% cspscript %}
            <script>
                async function startWebauthnAuthentication(lazy)
                {
                    let loaderEl = $('.card-loader');
                    let started = false;

                    await authenticateWebauthn(
                        lazy,
                        null,
                        '{{ path('webauthn.controller.security.main.request.options') }}',
                        '{{ path('webauthn.controller.security.main.request.result') }}',
                        function () {
                            loaderEl.addClass('visible');
                            started = true;
                        },
                        function (res) {
                            window.location.href = res.redirectUrl;
                        },
                        function (error) {
                            $('#authentication-error-message').text(error).removeClass('d-none');
                            loaderEl.removeClass('visible');

                            if (lazy && started) {
                                startWebauthnAuthentication(lazy);
                            }
                        }
                    );
                }

                $(document).ready(async function () {
                    if (await canUseWebauthnAutofill()) {
                        await startWebauthnAuthentication(true);
                    } else {
                        $('#login-with-passkey').removeClass('d-none');
                    }
                });

                $('#login-with-passkey').click(async function() {
                    await startWebauthnAuthentication(false);
                });
            </script>
        {% endcspscript %}
    {% endif %}
{% endblock %}
