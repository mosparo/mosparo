{% extends 'base.html.twig' %}

{% trans_default_domain 'mosparo' %}

{% block documentTitle %}{{ 'account.webauthn.manage.deleteKey.title'|trans({ '%keyName%': credential.name}) }} - {{ parent() }}{% endblock %}
{% block breadcrumbsContainer %}{% endblock %}
{% block pageTitle %}{% endblock %}

{% block pageBody %}
    <div class="container-tight pb-4">
        <div class="row">
            <div class="col text-center">
                <img src="{{ asset(get_illustration_path('webauthn.svg'))|add_path_prefix }}" class="mb-5 illustration-detail" alt="" />
            </div>
        </div>

        <form method="post">
            <div class="row">
                <div class="col">
                    <div class="card card-md">
                        <div class="card-body">
                            <h2 class="card-title text-center mb-4">{{ 'account.webauthn.manage.deleteKey.title'|trans({ '%keyName%': credential.name }) }}</h2>

                            <div class="alert alert-important alert-danger">
                                <div>
                                    <p>
                                        {{ 'account.webauthn.manage.deleteKey.confirm'|trans({ '%keyName%': '<strong>' ~ credential.name|escape ~ '</strong>' })|raw }}
                                    </p>
                                    {% if hasOnlyOnce %}
                                        <p class="strong">
                                            {% if enforcePasskey %}
                                                {{ 'account.webauthn.manage.deleteKey.infoLastPasskeyEnforced'|trans }}
                                            {% else %}
                                                {{ 'account.webauthn.manage.deleteKey.infoLastPasskey'|trans }}
                                            {% endif %}
                                        </p>
                                    {% endif %}
                                    <p>
                                        {{ 'account.webauthn.manage.deleteKey.infoUndo'|trans }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" name="delete-token" value="{{ csrf_token('delete-key') }}"/>

            <div class="row mt-3">
                <div class="col-12 col-md-auto mt-2 mt-md-0">
                    <a href="{{ path('account_webauthn_list') }}" class="btn btn-outline-secondary w-100" tabindex="1000">
                        <i class="ti ti-chevron-left"></i>
                        {{ 'rules.fieldRule.backToList'|trans }}
                    </a>
                </div>
                <div class="col-12 col-md-auto ms-auto order-first order-md-last">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="ti ti-circle-minus"></i>
                        {{ 'action.delete'|trans }}
                    </button>
                </div>
            </div>
        </form>
    </div>
{% endblock %}
