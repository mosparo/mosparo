# With this Dockerfile it is possible to build the standard image on Alpine Linux instead of Debian

FROM php:8.3-fpm-alpine

ARG MOSPARO_VERSION
ARG MOSPARO_CHANNEL=stable

ENV TERM=xterm

# Docker related
ENV MOSPARO_ENABLE_WEBSERVER=1
ENV MOSPARO_ENABLE_CRON=1

# mosparo related
ENV MOSPARO_UPDATES_ENABLED=0
ENV TRUSTED_PROXIES='127.0.0.1,REMOTE_ADDR'

# OCI annotations to image
LABEL org.opencontainers.image.authors="mosparo Core Developers" \
      org.opencontainers.image.title="mosparo" \
      org.opencontainers.image.description="The Modern Spam Protection for your form." \
      org.opencontainers.image.documentation="https://documentation.mosparo.io/" \
      org.opencontainers.image.base.name="php:8.3-fpm-alpine" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/mosparo/mosparo" \
      org.opencontainers.image.vendor="mosparo Core Developers" \
      org.opencontainers.image.version="${MOSPARO_VERSION}" \
      org.opencontainers.image.url="https://github.com/mosparo/mosparo"

WORKDIR /mosparo

# www-data is uid 82 on Alpine and uid 33 on Debian. The user is recreated with uid 33 so that the
# files in /mosparo-data keep their owner when an installation moves from the Debian image to this
# one. deluser removes the group of the user as well, so only the user has to be created again.
RUN deluser www-data && \
    addgroup -g 33 -S www-data && \
    adduser -u 33 -D -S -G www-data www-data

# curl is already part of the base image and is used by /usr/bin/mosparo-health-check, cron is part
# of BusyBox. The build dependencies are installed as a virtual package so they can be dropped again
# after the extensions have been built. musl has no locale support and no locale-gen, but mosparo
# does not use setlocale(), all locale aware formatting is done by ICU through intl.
RUN apk add --no-cache \
        nginx \
        sudo \
        icu-libs \
        libpng \
        libpq \
        libzip \
        sqlite-libs \
        libmemcached-libs \
        libsasl \
        zlib && \
    apk add --no-cache --virtual .build-deps \
        ${PHPIZE_DEPS} \
        icu-dev \
        libpng-dev \
        postgresql-dev \
        sqlite-dev \
        libzip-dev \
        libmemcached-dev \
        cyrus-sasl-dev \
        openssl-dev \
        zlib-dev && \
    docker-php-ext-install -j$(nproc) gd intl opcache pdo_mysql pdo_pgsql pdo_sqlite zip && \
    pecl install redis-6.1.0 && \
    pecl install memcached-3.3.0 && \
    docker-php-ext-enable redis memcached && \
    pecl clear-cache && \
    apk del --no-network .build-deps && \
    rm -rf /tmp/* /var/tmp/*

# Alpine only provides unzip as a BusyBox applet, the real unzip is installed for the extraction
RUN apk add --no-cache --virtual .fetch-deps unzip && \
    curl -fsSLO "https://github.com/mosparo/mosparo/releases/download/${MOSPARO_VERSION}/mosparo-${MOSPARO_CHANNEL}-${MOSPARO_VERSION}.zip" && \
    unzip "mosparo-${MOSPARO_CHANNEL}-${MOSPARO_VERSION}.zip" && \
    rm "mosparo-${MOSPARO_CHANNEL}-${MOSPARO_VERSION}.zip" && \
    apk del --no-network .fetch-deps

# Alpine's nginx includes /etc/nginx/http.d/*.conf instead of using sites-enabled and runs its
# workers as the nginx user; they have to run as www-data because run.sh hands the files in
# /mosparo-data to that user. BusyBox names the cron daemon crond and picks its applet by the name
# it was called by, so run.sh's "cron -f" needs a wrapper and not a symlink.
RUN sed -i 's/^user nginx;/user www-data;/' /etc/nginx/nginx.conf \
    && chown -R www-data:www-data /var/lib/nginx \
    && printf '#!/bin/sh\nexec /usr/sbin/crond "$@"\n' > /usr/sbin/cron \
    && chmod 0755 /usr/sbin/cron

ADD config/nginx.conf /etc/nginx/http.d/default.conf
ADD config/mosparo.cron /etc/cron.d/mosparo
ADD --chmod=0755 scripts/run.sh /usr/bin/run
ADD --chmod=0755 scripts/health.sh /usr/bin/mosparo-health-check

HEALTHCHECK --interval=1m --timeout=5s CMD /usr/bin/mosparo-health-check

RUN crontab -u www-data /etc/cron.d/mosparo

VOLUME /mosparo-data

EXPOSE 80

ENTRYPOINT []

CMD ["/usr/bin/run"]
